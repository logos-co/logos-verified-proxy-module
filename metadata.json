{
  "name": "verified_proxy_module",
  "display_name": "Verified Proxy Module",
  "version": "0.1.3",
  "description": "Light-client-verified Ethereum JSON-RPC, wrapping nimbus libverifproxy",
  "author": "Logos Core Team",
  "type": "core",
  "interface": "universal",
  "concurrency": "multi",
  "max_workers": 4,
  "category": "wallet",
  "main": "verified_proxy_module_plugin",
  "codegen": {
    "impl_header": "verified_proxy_impl.h",
    "impl_class": "VerifiedProxyImpl"
  },
  "dependencies": [],
  "include": [],
  "capabilities": [],
  "nix": {
    "packages": {
      "build": [
        "pkg-config"
      ],
      "runtime": [
        "nlohmann_json",
        "libmicrohttpd",
        "curl"
      ]
    },
    "platforms": [
      {
        "when": { "os": "windows" },
        "packages": { "runtime": [ "windows.pthreads" ] }
      }
    ],
    "external_libraries": [
      {
        "name": "verifproxy"
      }
    ],
    "cmake": {
      "extra_include_dirs": [
        "lib"
      ]
    }
  }
}
